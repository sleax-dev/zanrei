{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zanrei",
  "version": "0.5.4",
  "identifier": "app.zanrei.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zanrei",
        "width": 1120,
        "height": 740,
        "center": true,
        "transparent": true,
        "theme": "Dark",
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Turkish",
          "Spanish",
          "German",
          "French",
          "PortugueseBR",
          "Russian",
          "SimpChinese",
          "Japanese",
          "Arabic"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2Nzk2RkM1QjcxNDE0QzAKUldUQUZCUzN4Vzk1QnN6TmhwQTJYUG1YVDNXM3g0cUlWd1V6WjBkTDRnWUs3cnMxdnZTREZTd0cK",
      "endpoints": [
        "https://github.com/sleax-dev/zanrei/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
